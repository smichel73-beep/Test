				</dict>
				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Shell-Skript ausführen</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/usr/bin/env bash
# Finder Quick Action: Ausgewählte Dateien transkribieren

# PATH erweitern damit ~/bin und Homebrew gefunden werden
export PATH="$HOME/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Alle ausgewählten Dateien als Argumente übergeben
DATEIEN=()
while IFS= read -r datei; do
    DATEIEN+=("$datei")
done

if [ ${#DATEIEN[@]} -eq 0 ]; then
    osascript -e 'display alert "Keine Datei ausgewählt" message "Bitte eine Audio- oder Videodatei im Finder auswählen."'
    exit 1
fi

# Transkription starten
transkribiere "${DATEIEN[@]}"

# Erste TXT-Datei in TextEdit öffnen
ERSTE_DATEI="${DATEIEN[0]}"
BASISNAME=$(basename "$ERSTE_DATEI")
BASISNAME="${BASISNAME%.*}"
TXT_DATEI="$HOME/Transkripte/$BASISNAME.txt"

if [ -f "$TXT_DATEI" ]; then
    open -a TextEdit "$TXT_DATEI"
    osascript -e "display notification \"Transkript gespeichert: $BASISNAME.txt\" with title \"Transkription abgeschlossen\""
else
    osascript -e 'display alert "Transkription fehlgeschlagen" message "Bitte Terminal auf Fehlermeldungen prüfen."'
fi
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
					<key>source</key>
					<string></string>
